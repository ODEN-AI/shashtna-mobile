{
  "expo": {
    "name": "شاشتنا",
    "slug": "shashtna",
    "scheme": "shashtna",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050A14",
    "primaryColor": "#2F6BFF",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shashtna.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور حتى ترفع صورة إثبات الدفع لطلبك.",
        "NSCameraUsageDescription": "نحتاج الكاميرا حتى تصوّر إثبات الدفع لطلبك.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.shashtna.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#050A14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "shashtna"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2F6BFF",
          "defaultChannel": "account"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور حتى ترفع صورة إثبات الدفع لطلبك.",
          "cameraPermission": "نحتاج الكاميرا حتى تصوّر إثبات الدفع لطلبك.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#050A14"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://shashtna.netlify.app",
      "eas": {
        "projectId": "bb8ff136-b88e-4986-a256-d5ff004b9603"
      },
      "router": {}
    },
    "owner": "abdulrahman_amer"
  }
}
